---
// The header (the draft's .ih): the way home ("← zhenyuan lu" in the pixel lettering) and the fader, nothing
// else. It stays at the top while the page scrolls; a faint rule appears under it once the page has gone beneath
// it (scripts/site.js). Skip to the page: out of sight until the keyboard reaches it.
import PixelWord from './PixelWord.astro';
import Fader from './Fader.astro';
import { url } from '../lib/site';
import { arrowSvg } from '../lib/arrows.mjs';
---
<header class="ih">
  <a class="skip" href="#ip">skip to the page</a>
  <a class="ih-name" href={url('/')} aria-label="zhenyuan lu, home"><span class="ih-ar" aria-hidden="true" set:html={arrowSvg('l')}></span><PixelWord text="zhenyuan lu" cell={1} ui class="ih-nm" /></a>
  <div class="ih-fade"><Fader /></div>
</header>
