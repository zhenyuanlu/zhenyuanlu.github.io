{
  "name": "zhenyuanlu-com",
  "version": "3.0.0",
  "private": true,
  "description": "zhenyuanlu.com: the personal site of Zhenyuan Lu, built with Astro from the content/ folder.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "images": "node scripts/images.mjs",
    "preview": "astro preview",
    "build:lan": "node scripts/build-lan.mjs",
    "new:post": "node scripts/new-post.mjs",
    "check": "astro check && astro build --force && node scripts/check-dist.mjs && node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/figtree": "5.3.0",
    "@shikijs/transformers": "4.5.0",
    "astro": "7.4.0",
    "hast-util-to-html": "9.0.5",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-smartypants": "3.0.3",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "hast-util-from-html": "2.0.3",
    "html-validate": "11.16.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
